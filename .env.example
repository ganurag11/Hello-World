# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Canva OAuth 2.0 ───────────────────────────────────────────────────────────
# Create an integration at https://www.canva.com/developers/
# Set redirect URI to http://localhost:8080/callback in your integration settings
CANVA_CLIENT_ID=your_client_id_here
CANVA_CLIENT_SECRET=your_client_secret_here

# These are filled in automatically after running: python agent.py --oauth
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=
CANVA_REDIRECT_URI=http://localhost:8080/callback

# ── Web Search (choose one provider) ─────────────────────────────────────────
# Brave Search API: https://api.search.brave.com/
# SerpAPI:          https://serpapi.com/
#
# If left empty, the agent will use built-in 2026 fitness design trend defaults.
SEARCH_API_KEY=
SEARCH_PROVIDER=brave
